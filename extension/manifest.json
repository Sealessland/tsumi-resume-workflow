{
  "manifest_version": 3,
  "name": "秋招投递归档",
  "version": "0.1.0",
  "description": "确认投递成功后，将岗位信息归档到飞书多维表格。",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1:43118/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "归档本次投递" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }]
}
